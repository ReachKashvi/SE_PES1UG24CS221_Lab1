@startuml Digital Gift Card & Loyalty Point Exchange - Use Case Diagram
' Problem Statement #34  |  SRN: PES1UG24CS221
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Account Holder"        as AH
actor "Merchant Partner"      as MP
actor "Fraud / Voucher-Locking Service" as FS
actor "Payment / Settlement Gateway"    as PG

rectangle "Digital Gift Card & Loyalty Point Exchange" {
    usecase "Link & Aggregate\nLoyalty Accounts"   as UC1
    usecase "Convert Points\nto Exchange Credits"  as UC2
    usecase "Redeem\nDigital Gift Card"            as UC3
    usecase "Validate & Lock\nVoucher"             as UC4
    usecase "Configure Dynamic\nExchange Rate"     as UC5
    usecase "Authenticate User"                    as UC6
    usecase "Apply Promotional\nBonus"             as UCX
}

' --- Associations ---
AH --> UC1
AH --> UC2
AH --> UC3
MP --> UC5
FS --> UC4
UC3 --> PG

' --- Stereotyped relationships ---
UC2 ..> UC4 : <<include>>
UC3 ..> UC4 : <<include>>
UC2 ..> UC6 : <<include>>
UC3 ..> UC6 : <<include>>
UCX ..> UC3 : <<extend>>

@enduml
